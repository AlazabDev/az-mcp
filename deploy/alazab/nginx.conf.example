# Example HTTPS virtual host. Existing certificate handling stays in the
# host's Nginx configuration. Keep authorization headers intact for MCP.
server {
    listen 80;
    server_name mcp.alazab.com;
    # Use your existing TLS configuration; do not publicly deploy plain HTTP.
    return 301 https://$host$request_uri;
}
